function scheduleMidnightRefresh(){

    const now=new Date();


    /*
       Next day 12:00:01 AM
    */

    const nextMidnight =
        new Date(
            now.getFullYear(),
            now.getMonth(),
            now.getDate()+1,
            0,
            0,
            1
        );


    const timeUntilMidnight =
        nextMidnight.getTime() -
        now.getTime();


    setTimeout(function(){

        /*
           Update current date
        */

        currentDate=new Date();


        /*
           Refresh dashboard,
           subjects and calendar
        */

        renderAll();


        /*
           If calendar is open,
           make today's month visible.
        */

        const calendarSection =
            document.getElementById(
                "calendar"
            );


        if(
            calendarSection &&
            calendarSection.classList.contains(
                "active"
            )
        ){

            currentDate=new Date();

            renderCalendar();

        }


        /*
           Start timer for next midnight
        */

        scheduleMidnightRefresh();

    },timeUntilMidnight);

}


/* =====================================================
   START MIDNIGHT TIMER
===================================================== */

scheduleMidnightRefresh();


