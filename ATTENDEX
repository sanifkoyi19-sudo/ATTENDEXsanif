/* =====================================================
   DASHBOARD
===================================================== */

function calculateOverall(){

    let present=0;
    let absent=0;

    Object.keys(records).forEach(function(date){

        const day=records[date];

        Object.keys(day).forEach(function(subject){

            const status=day[subject];

            if(
                subjects.includes(subject) &&
                status==="present"
            ){

                present++;

            }

            if(
                subjects.includes(subject) &&
                status==="absent"
            ){

                absent++;

            }

        });

    });

    const conducted =
        present+absent;

    const percentage =
        conducted===0
        ? 0
        : (present/conducted)*100;

    return {
        present,
        absent,
        conducted,
        percentage
    };

}


function renderDashboard(){

    const stats =
        calculateOverall();

    document
    .getElementById("overallPercentage")
    .textContent =
        stats.percentage.toFixed(1)+"%";

    document
    .getElementById("overallProgress")
    .style.width =
        Math.min(stats.percentage,100)+"%";

    document
    .getElementById("presentHours")
    .textContent =
        stats.present;

    document
    .getElementById("absentHours")
    .textContent =
        stats.absent;

    document
    .getElementById("conductedHours")
    .textContent =
        stats.conducted;

    renderHomeSubjects();

}


/* =====================================================
   SUBJECT STATS
===================================================== */

function getSubjectStats(subject){

    let present=0;
    let absent=0;

    Object.keys(records).forEach(function(date){

        const day=records[date];

        if(day[subject]==="present"){
            present++;
        }

        if(day[subject]==="absent"){
            absent++;
        }

    });

    const conducted =
        present+absent;

    const percentage =
        conducted===0
        ? 0
        : (present/conducted)*100;

    return {
        present,
        absent,
        conducted,
        percentage
    };

}


